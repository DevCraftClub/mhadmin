<?php

declare(strict_types=1);

namespace DevCraft\Modules\%dir%;

use DevCraft\Core\Abstracts\AbstractModuleIdentity;

/**
 * Identity модуля %name%.
 */
final class %dir%Identity extends AbstractModuleIdentity {

	public const string MODULE = '%dir%';

	public const string CODE = '%latin%';

	public const string VERSION = '%version%';

	public static function name(): string {
    	return __('%name%');
    }

    public static function description(): string {
    	return __('%description%');
    }

    public static function icon(): string {
    	return '%icon%';
    }

    public static function siteUrl(): string {
    	return '%link%';
    }

    public static function docsUrl(): string {
    	return '%docs%';
    }

}
