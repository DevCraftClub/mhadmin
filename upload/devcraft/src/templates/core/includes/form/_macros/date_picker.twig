{% macro date_picker(id, label, descr, value, opts) %}
    {% include 'core/includes/form/templateIncludes/field_row.twig' with {
        widget: 'core/includes/form/templateIncludes/date_picker.twig',
        id: id,
        label: label,
        descr: descr,
        value: value,
        opts: opts|default({})
    } %}
{% endmacro %}
