{% set current_locale = devcraft_locale|default('ru_RU') %}
<div class="dc-topbar">
    <div class="dropdown-button dc-topbar__lang">
        <button type="button" class="button square flat" data-dc-language-current="{{ current_locale }}" aria-label="{{ 'Язык админки'|trans }}" title="{{ 'Язык админки'|trans }}">
            <span class="mif-translate"></span>
        </button>
        <ul class="d-menu" data-role="dropdown">
            {% for language in devcraft_languages|default([]) %}
                <li{% if language.tag == current_locale %} class="active"{% endif %}>
                    <a href="#" data-dc-language="{{ language.tag }}"{% if language.tag == current_locale %} aria-current="true"{% endif %}>{{ language.name }}</a>
                </li>
            {% endfor %}
        </ul>
    </div>
    <a class="button square outline dc-topbar__cache"
       href="?mod={{ mod|default('devcraft')|url_encode }}&action=clear_cache&user_hash={{ dle_login_hash|default('')|url_encode }}&return={{ action|default('dashboard')|url_encode }}"
       title="{{ 'Очистить кеш'|trans }}"
       aria-label="{{ 'Очистить кеш'|trans }}">
        <span class="mif-bin"></span>
    </a>
    <button type="button"
            class="button square outline dc-topbar__theme"
            data-dc-theme="{{ devcraft_theme|default('light') }}"
            title="{{ 'Тема оформления админки'|trans }}">
        <span class="mif-dark-light"></span>
    </button>
    <div class="dropdown-button dc-topbar__user">
        <button type="button" class="button flat">
            {% if admin_user_avatar_url %}
                <img class="dc-topbar__avatar" src="{{ admin_user_avatar_url }}" alt="">
            {% else %}
                <span class="mif-user-settings dc-topbar__avatar dc-topbar__avatar--empty"></span>
            {% endif %}
            <span class="dc-topbar__name">{{ admin_user_name|default('') }}</span>
        </button>
        <ul class="d-menu" data-role="dropdown">
            {% if admin_user_profile_url %}
                <li><a href="{{ admin_user_profile_url }}" target="_blank" rel="noopener">{{ 'Профиль'|trans }}</a></li>
            {% endif %}
            <li><a href="{{ admin_logout_url|default('?action=logout') }}">{{ 'Выход'|trans }}</a></li>
        </ul>
    </div>
</div>
