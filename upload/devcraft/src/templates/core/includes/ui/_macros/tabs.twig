{% macro tabs(id, items, opts) %}
    {% include 'core/includes/ui/templateIncludes/tabs.twig' with {
        id: id,
        items: items,
        opts: opts|default({})
    } %}
{% endmacro %}

{% macro tabs_sections(id, sections, opts) %}
    {% include 'core/includes/ui/templateIncludes/tabs_sections.twig' with {
        id: id,
        sections: sections,
        opts: opts|default({})
    } %}
{% endmacro %}
