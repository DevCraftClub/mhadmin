{% import 'core/includes/_macros/author.twig' as author %}
{% set d = dashboard %}
{% set app = d.app %}

<div class="dc-dashboard"
     data-site-id="{{ app.siteId|default(0) }}"
     data-version="{{ app.version }}">
    <div class="more-info-box mb-4">

        <div class="icon">
            <span class="{{ app.icon }}"></span>
        </div>
        <div class="content p-2">
            <div class="value">{{ app.name }} </div>
            {% if app.description %}<p class="title">{{ app.description }}</p>{% endif %}
        </div>

        <div class="more">
            {% if app.siteLink %}
                <a href="{{ app.siteLink }}" class="button outline mini mr-1" target="_blank" rel="noopener">
                    <span class="mif-earth mr-1"></span> {{ 'Сайт'|trans }}
                </a>
            {% endif %}
            {% if app.docsLink %}
                <a href="{{ app.docsLink }}" class="button outline mini mr-1" target="_blank" rel="noopener">
                    <span class="mif-library mr-1"></span> {{ 'Документация'|trans }}
                </a>
            {% endif %}
            {% if app.licLink %}
            <a href="{{ app.licLink }}" class="button outline mini mr-1" target="_blank" rel="noopener">
                <span class="mif-grading mr-1"></span> {{ 'Пользовательское соглашение'|trans }}
            </a>
            {% endif %}
            {% if d.show_assets|default(false) %}
                <button type="button" class="button outline mini mr-1 js-check-assets">
                    <span class="mif-loop2 mr-1 js-check-assets-icon"></span> {{ 'Проверить ресурсы'|trans }}
                    <span class="badge inline bg-red fg-white ml-1 dc-assets-badge d-none" id="dc-assets-badge">0</span>
                </button>
            {% endif %}

            {% if app.siteId|default(0) > 0 %}
                <button type="button" class="button outline mini js-check-update">
                    <span class="mif-cloud-upload mr-1"></span> {{ 'Проверить версию'|trans }}
                </button>
            {% else %}
                <button type="button" class="button outline mini" disabled title="{{ 'ID ресурса не настроен в manifest.php'|trans }}">
                    <span class="mif-cloud-upload mr-1"></span> {{ 'Проверить версию'|trans }}
                </button>
            {% endif %}
            <span class="badge badge-red">v{{ app.version }}</span>

            {% if app.crowdinName and app.crowdinStatId %}
                <a href="https://crowdin.com/project/{{ app.crowdinName }}" class="button outline mini mr-1" target="_blank" rel="noopener">
                    <img src="https://img.shields.io/badge/dynamic/json?color=blue&label={{ devcraft_html_lang }}&style=flat&logo=crowdin&query=%24.progress.0.data.translationProgress&url=https%3A%2F%2Fbadges.awesome-crowdin.com%2Fstats-{{ app.crowdinStatId }}.json" />
                </a>
            {% endif %}
        </div>

    </div>

    {% if d.stats is defined and d.stats|length > 0 %}
        <div class="remark dc-dashboard-card dc-dashboard-stats mb-4">
            {% if d.stats_title|default('') %}
                <h4 class="border-bottom bd-default pb-2 mb-3">{{ d.stats_title }}</h4>
            {% endif %}
            <div class="row flex-justify-center">
                {% for stat in d.stats %}
                    <div class="cell-md-2 cell-sm-4 cell-6 mb-2">
                        {% if stat.url %}
                            <a href="{{ stat.url }}" class="dc-dashboard-stat dc-dashboard-stat-link">
                        {% else %}
                            <div class="dc-dashboard-stat">
                        {% endif %}
                            {% if stat.icon|default('') %}
                                <span class="dc-dashboard-stat-icon {{ stat.icon }}" aria-hidden="true"></span>
                            {% endif %}
                            <div class="dc-dashboard-stat-value">{{ stat.value }}</div>
                            <div class="dc-dashboard-stat-label">{{ stat.label }}</div>
                        {% if stat.url %}
                            </a>
                        {% else %}
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if d.show_assets|default(false) %}
        <div id="dc-assets-status" class="remark info dc-assets-status mb-4 d-none" data-auto-check="1"></div>
    {% endif %}

    {% include 'core/includes/dashboard/composer_panel.twig' %}

    {% if mod|default('') == 'devcraft' %}
        <div class="remark info mt-4">
            <h5>{{ 'База данных'|trans }}</h5>
            <p>{{ 'Создаёт недостающие таблицы ядра и модулей. Уже записанные строки не удаляет.'|trans }}</p>
            <button type="button" class="button primary" id="dc-schema-sync">{{ 'Создать / обновить таблицы'|trans }}</button>
        </div>
    {% endif %}

    <div class="grid dc-dashboard-grid">
        <div class="row">
            <div class="cell-md-6">
                {{ author.dashboard_card(d.author) }}
            </div>
            <div class="cell-md-6">
                <div class="remark dc-dashboard-card">
                    <h4 class="border-bottom bd-default pb-2 mb-3">{{ 'Разделы'|trans }}</h4>
                    {% if d.menu|length > 0 %}
                        <table class="table striped subcompact">
                            <thead>
                            <tr>
                                <th>{{ 'Раздел'|trans }}</th>
                                <th></th>
                            </tr>
                            </thead>
                            <tbody>
                            {% for item in d.menu %}
                                <tr>
                                    <td>
                                        {% if item.icon %}<span class="{{ item.icon }} mr-1"></span>{% endif %}
                                        {{ item.name }}
                                    </td>
                                    <td class="text-right">
                                        <a href="{{ item.link }}" class="button small">{{ 'Открыть'|trans }}</a>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="fg-gray">{{ 'Разделы не настроены.'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if d.changelog_latest %}
            <div class="row">
                <div class="cell-12">
                    <div class="remark dc-dashboard-card">
                        <h4 class="border-bottom bd-default pb-2 mb-3">
                            {{ 'Последние изменения'|trans }}
                            <a href="{{ d.changelog_url }}" class="button small link float-right">{{ 'Вся история'|trans }}</a>
                        </h4>
                        <p class="mb-2">
                            {% if d.changelog_latest.version == 'Неопубликованное'|trans %}
                                <strong>{% trans %}Неопубликованное{% endtrans %}</strong>
                            {% else %}
                                <strong>v{{ d.changelog_latest.version }}</strong>
                            {% endif %}
                            {% if d.changelog_latest.date %}
                                <span class="text-small fg-gray">({{ d.changelog_latest.date }})</span>
                            {% endif %}
                        </p>
                        {% if d.changelog_latest.teaser_items is defined and d.changelog_latest.teaser_items|length > 0 %}
                            <ul class="mt-2">
                                {% for item in d.changelog_latest.teaser_items %}
                                    <li><span class="text-small fg-gray">{{ item.title }}:</span> {{ item.text|raw }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
